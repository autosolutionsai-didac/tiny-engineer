(footprint "Seeed_XIAO_ESP32S3_Socketed"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Seeed Studio XIAO ESP32S3 (21 x 17.8 mm) plugged into two 1x7 2.54 mm female sockets, rows 15.24 mm apart. Pin 1 = D0 next to the USB-C end; numbering per Seeed OPL KiCad library (XIAO-ESP32-S3-DIP). USB-C receptacle protrudes ~1.5 mm past the module edge (marked). U.FL antenna on module: keep antenna clear of metal and the servo rail.")
	(tags "XIAO ESP32S3 Seeed socket module")
